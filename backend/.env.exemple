# ─── Base de données ───────────────────────────────────────────
MONGO_URI=mongodb+srv:///zandoo


# ─── Serveur ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost

# ─── JWT ───────────────────────────────────────────────────────
# ⚠️  Changez cette valeur par une chaîne aléatoire longue en production
JWT_SECRET=@123
JWT_EXPIRES_IN=7d



#Google 
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── Admin ─────────────────────────────────────────────────────
ADMIN_EMAIL=Zan
ADMIN_PASSWORD=ZanD

# ─── Email (SMTP) ──────────────────────────────────────────────
# Pour Gmail : activez "Mots de passe d'application" dans votre compte Google
# Pour Mailtrap (dev) : https://mailtrap.io
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre.email@gmail.com
SMTP_PASS=votre_mot_de_passe_app
