# ─── Base de données ───────────────────────────────────────────
MONGO_URI=mongodb+srv:///zandoo


# ─── Serveur ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Nombre de proxys devant l'API en production (Render/Nginx/Cloudflare : 1). 0 en local.
TRUST_PROXY=0

# ─── JWT ───────────────────────────────────────────────────────
# 32 caractères aléatoires minimum (le serveur refuse de démarrer en production sinon) :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d



#Google 
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── Admin (uniquement pour « npm run seed:admin », inutile au serveur) ───
# Mot de passe : 12 caractères min., majuscule, minuscule, chiffre, caractère spécial.
# Retirez ces deux lignes de l'environnement une fois le compte créé.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Email (SMTP) ──────────────────────────────────────────────
# Pour Gmail : activez "Mots de passe d'application" dans votre compte Google
# Pour Mailtrap (dev) : https://mailtrap.io
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre.email@gmail.com
SMTP_PASS=votre_mot_de_passe_app
# Adresse qui reçoit les messages du formulaire de contact (défaut : SMTP_USER)
CONTACT_EMAIL=

# ─── Cloudinary (stockage images & vidéos) ─────────────────────
# Créez un compte sur https://cloudinary.com et récupérez ces valeurs
# dans Dashboard > API Keys
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret
